// Two-sided environment pieces (S5 m_env_double: kelp blades, seagrass, torn net): see env_palette.gdshaderinc.
// The facet normal is turned towards the camera in the include, so both sides get the toon light.
shader_type spatial;
render_mode cull_disabled;

#include "res://shaders/env_palette.gdshaderinc"
