[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60

[rendering]

; Desktop default: Forward+. To test the portable look (weak iGPU, web, mobile), run with:
;   godot --rendering-method gl_compatibility --path game
; or change this value to "gl_compatibility". Never rely on Forward+-only features
; (volumetric fog, SSR, compute shaders) for gameplay readability.
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
; Required by the Windows Desktop export preset (texture_format/s3tc_bptc): the exporter refuses a desktop target
; with "Import S3TC BPTC" off. No texture uses VRAM compression today (palette / caustics are lossless).
textures/vram_compression/import_s3tc_bptc=true
