extends TestCase
## Deterministic replay: same seed + same command script -> identical state_hash() after 300 ticks.
## The script is generated by a local LCG so the test input does not depend on SimRng (code under test).

const TICKS: int = 300
const SCRIPT_LEN: int = 150
const SPECIES: Array[StringName] = [&"small_reef_fish", &"silver_schooling_fish", &"puffer", &"barracuda", &"shark"]


class _Lcg:
	var s: int
	func _init(p_seed: int) -> void:
		s = p_seed & 0x7FFFFFFF
	func next() -> int:
		s = (s * 1103515245 + 12345) & 0x7FFFFFFF
		return s
	func unit() -> float:
		return float(next() % 10000) / 10000.0


## Script entry: {tick:int, kind:int (SimCommand.Type), entity:int, dir:Vector3, thrust:float, flag:bool, target:int, ability:StringName}
func _gen_script(script_seed: int) -> Array[Dictionary]:
	var lcg := _Lcg.new(script_seed)
	var abilities: Array[StringName] = [&"boost", &"bite_dash", &"sonar"]
	var out: Array[Dictionary] = []
	for i in SCRIPT_LEN:
		var entry: Dictionary = {}
		entry["tick"] = lcg.next() % 250
		entry["kind"] = lcg.next() % 4
		entry["entity"] = 1 + lcg.next() % SPECIES.size()
		var dir := Vector3(lcg.unit() - 0.5, lcg.unit() - 0.5, lcg.unit() - 0.5)
		if dir.length() < 0.1:
			dir = Vector3.RIGHT
		entry["dir"] = dir
		entry["thrust"] = 0.3 + 0.7 * lcg.unit()
		entry["flag"] = lcg.next() % 2 == 0
		entry["target"] = 1 + lcg.next() % SPECIES.size()
		entry["ability"] = abilities[lcg.next() % abilities.size()]
		out.append(entry)
	# make sure all four command types and several entities are really present
	out[0]["kind"] = SimCommand.Type.MOVE
	out[1]["kind"] = SimCommand.Type.BOOST
	out[2]["kind"] = SimCommand.Type.BITE
	out[3]["kind"] = SimCommand.Type.ABILITY
	return out


func _make_cmd(e: Dictionary, as_current: bool) -> SimCommand:
	var tick: int = -1 if as_current else int(e["tick"])
	var entity: int = e["entity"]
	var kind: int = e["kind"]
	match kind:
		SimCommand.Type.MOVE:
			var d: Vector3 = e["dir"]
			var th: float = e["thrust"]
			return SimCommand.move(entity, d, th, tick)
		SimCommand.Type.BOOST:
			var on: bool = e["flag"]
			return SimCommand.boost(entity, on, tick)
		SimCommand.Type.BITE:
			var tgt: int = e["target"]
			return SimCommand.bite(entity, tgt, tick)
		_:
			var ab: StringName = e["ability"]
			return SimCommand.ability(entity, ab, tick)


func _build_world(world_seed: int, content: ContentDB = null) -> SimWorld:
	var w := SimWorld.new(world_seed, content)
	for i in SPECIES.size():
		w.spawn_entity(SPECIES[i], Vector3(i * 3.0, 0.0, -i * 2.0), 0.15 + 0.4 * i, i == 0)
	return w


## Mode A: submit everything up front with explicit target ticks, then step.
func _run_upfront(w: SimWorld, script: Array[Dictionary]) -> int:
	for e in script:
		w.submit(_make_cmd(e, false))
	for i in TICKS:
		w.step()
	return w.state_hash()


## Mode B: submit each command right before its tick with tick = -1 (current).
func _run_just_in_time(w: SimWorld, script: Array[Dictionary]) -> int:
	for t in TICKS:
		for e in script:
			if int(e["tick"]) == t:
				w.submit(_make_cmd(e, true))
		w.step()
	return w.state_hash()


## Mode C: entity-major push order (all commands of entity 1, then entity 2, ...). Per-entity order is preserved.
func _run_entity_major(w: SimWorld, script: Array[Dictionary]) -> int:
	for entity in range(SPECIES.size(), 0, -1):  # descending: worst case for a queue that sorts by arrival
		for e in script:
			if int(e["entity"]) == entity:
				w.submit(_make_cmd(e, false))
	for i in TICKS:
		w.step()
	return w.state_hash()


# ---- same input -> same hash ----

func test_same_seed_same_script_same_hash() -> void:
	var script := _gen_script(1001)
	var h1: int = _run_upfront(_build_world(42), script)
	var h2: int = _run_upfront(_build_world(42), script)
	assert_eq(h1, h2, "two worlds with the same seed and command script must hash equally after %d ticks" % TICKS)


func test_replay_many_times() -> void:
	var script := _gen_script(55)
	var first: int = _run_upfront(_build_world(7), script)
	for i in 4:
		assert_eq(_run_upfront(_build_world(7), script), first, "replay #%d diverged" % i)


func test_script_actually_exercises_the_sim() -> void:
	# Guards against a vacuous determinism test: the script must change the state versus doing nothing.
	var script := _gen_script(1001)
	var idle := _build_world(42)
	for i in TICKS:
		idle.step()
	var driven_hash: int = _run_upfront(_build_world(42), script)
	assert_ne(driven_hash, idle.state_hash(), "commands must influence the state hash (script is not vacuous)")


func test_script_covers_all_command_types_and_entities() -> void:
	var script := _gen_script(1001)
	var kinds: Dictionary = {}
	var entities: Dictionary = {}
	var ticks: Dictionary = {}
	for e in script:
		kinds[e["kind"]] = true
		entities[e["entity"]] = true
		ticks[e["tick"]] = true
	assert_eq(kinds.size(), 4, "MOVE, BOOST, BITE and ABILITY must all occur")
	assert_true(entities.size() >= 4, "several entities must be commanded, got %d" % entities.size())
	assert_true(ticks.size() >= 50, "commands must be spread over varying ticks, got %d distinct" % ticks.size())


func test_hash_is_independent_of_push_interleaving() -> void:
	var script := _gen_script(2002)
	var upfront: int = _run_upfront(_build_world(9), script)
	var entity_major: int = _run_entity_major(_build_world(9), script)
	assert_eq(entity_major, upfront, "entity-major push order must not change the outcome (server-authoritative ordering)")


func test_hash_is_independent_of_submission_time() -> void:
	var script := _gen_script(3003)
	var upfront: int = _run_upfront(_build_world(9), script)
	var jit: int = _run_just_in_time(_build_world(9), script)
	assert_eq(jit, upfront, "submitting with tick=-1 just before the tick must equal submitting with an explicit tick")


func test_hash_is_independent_of_frame_pacing() -> void:
	# Same commands, but the world is driven by advance() with irregular frame deltas instead of step().
	var script := _gen_script(4004)
	var by_step: int = _run_upfront(_build_world(5), script)
	var w := _build_world(5)
	for e in script:
		w.submit(_make_cmd(e, false))
	var frame: int = 0
	var deltas: Array[float] = [0.0137, 0.009, 0.0211, 0.0166, 0.0049]
	while w.tick < TICKS:
		w.advance(deltas[frame % deltas.size()])  # every delta < TICK_DT, so each call runs at most one step
		frame += 1
	assert_eq(w.tick, TICKS, "driven to exactly %d ticks" % TICKS)
	assert_eq(w.state_hash(), by_step, "advance() pacing must not influence the simulation result")


func test_replay_with_real_content() -> void:
	var content := ContentDB.load_from_dir()
	assert_true(content.is_valid(), "real data must be valid: %s" % "\n".join(content.errors))
	var script := _gen_script(1001)
	var h1: int = _run_upfront(_build_world(42, content), script)
	var h2: int = _run_upfront(_build_world(42, content), script)
	assert_eq(h1, h2, "determinism must hold with ContentDB-driven band speeds")


func test_replay_with_rng_consumption() -> void:
	# The world's own rng is part of the hash: consuming it identically must keep worlds equal,
	# consuming it differently must not.
	var script := _gen_script(1001)
	var a := _build_world(42)
	var b := _build_world(42)
	a.rng.next_u32()
	b.rng.next_u32()
	assert_eq(_run_upfront(a, script), _run_upfront(b, script), "same rng consumption -> same hash")
	var c := _build_world(42)
	c.rng.next_u32()
	c.rng.next_u32()
	var d := _build_world(42)
	d.rng.next_u32()
	assert_ne(_run_upfront(c, script), _run_upfront(d, script), "different rng consumption -> different hash")


# ---- different input -> different hash ----

func test_different_seed_different_hash() -> void:
	var script := _gen_script(1001)
	var h1: int = _run_upfront(_build_world(42), script)
	var h2: int = _run_upfront(_build_world(43), script)
	assert_ne(h1, h2, "a different world seed must change the hash")


func test_changed_command_direction_changes_hash() -> void:
	var script := _gen_script(1001)
	var baseline: int = _run_upfront(_build_world(42), script)
	var tweaked := _gen_script(1001)
	var changed: bool = false
	for e in tweaked:
		if int(e["kind"]) == SimCommand.Type.MOVE and int(e["tick"]) < 200:
			var d: Vector3 = e["dir"]
			e["dir"] = -d
			changed = true
			break
	assert_true(changed, "test setup: script must contain an early MOVE")
	assert_ne(_run_upfront(_build_world(42), tweaked), baseline, "flipping one MOVE direction must change the hash")


func test_dropped_command_changes_hash() -> void:
	var script := _gen_script(1001)
	var baseline: int = _run_upfront(_build_world(42), script)
	var shorter := _gen_script(1001)
	for i in shorter.size():
		if int(shorter[i]["kind"]) == SimCommand.Type.MOVE and int(shorter[i]["tick"]) < 200:
			shorter.remove_at(i)
			break
	assert_eq(shorter.size(), script.size() - 1, "test setup: one command dropped")
	assert_ne(_run_upfront(_build_world(42), shorter), baseline, "removing one MOVE must change the hash")


func test_shifted_command_tick_changes_hash() -> void:
	var script := _gen_script(1001)
	var baseline: int = _run_upfront(_build_world(42), script)
	var shifted := _gen_script(1001)
	for e in shifted:
		if int(e["kind"]) == SimCommand.Type.MOVE and int(e["tick"]) < 200:
			e["tick"] = int(e["tick"]) + 7
			break
	assert_ne(_run_upfront(_build_world(42), shifted), baseline, "executing a MOVE 7 ticks later must change the hash")


func test_changed_thrust_changes_hash() -> void:
	var script := _gen_script(1001)
	var baseline: int = _run_upfront(_build_world(42), script)
	var tweaked := _gen_script(1001)
	for e in tweaked:
		if int(e["kind"]) == SimCommand.Type.MOVE and int(e["tick"]) < 200:
			e["thrust"] = 0.05
			break
	assert_ne(_run_upfront(_build_world(42), tweaked), baseline, "changing a MOVE thrust must change the hash")


func test_different_spawn_position_changes_hash() -> void:
	var script := _gen_script(1001)
	var baseline: int = _run_upfront(_build_world(42), script)
	var w := SimWorld.new(42)
	for i in SPECIES.size():
		var x: float = i * 3.0 + (0.25 if i == 2 else 0.0)
		w.spawn_entity(SPECIES[i], Vector3(x, 0.0, -i * 2.0), 0.15 + 0.4 * i, i == 0)
	assert_ne(_run_upfront(w, script), baseline, "moving one spawn point must change the hash")


# ---- idle worlds ----

func test_idle_worlds_stay_equal_for_300_ticks() -> void:
	var a := _build_world(1)
	var b := _build_world(1)
	for i in TICKS:
		a.step()
		b.step()
	assert_eq(a.state_hash(), b.state_hash(), "no commands: still identical")
	assert_eq(a.tick, TICKS, "tick count")
